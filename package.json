{
  "name": "avokarto-platform",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "predev": "npm run icons:generate",
    "dev": "next dev",
    "predev:webpack": "npm run icons:generate",
    "dev:webpack": "next dev --webpack",
    "prebuild": "npm run icons:generate",
    "build": "next build --webpack",
    "preanalyze": "npm run icons:generate",
    "analyze": "cross-env ANALYZE=true next build --webpack",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test:shipping": "node --test scripts/test-shipping-policy.mjs",
    "test:resources": "node --test scripts/test-resource-requests.mjs",
    "test:database": "node --test scripts/test-database-errors.mjs",
    "test:deploy": "node --test scripts/test-deploy-config.mjs",
    "test:seo": "node --test scripts/test-seo.mjs",
    "seo:check": "node scripts/check-seo-http.mjs",
    "seo:check:render": "node scripts/check-seo-render.mjs",
    "test:seo-routes": "node --test scripts/test-seo-routes.mjs",
    "test:customer-security": "node --test scripts/test-customer-security.mjs",
    "test:buy-now": "node --test scripts/test-buy-now.mjs",
    "test": "npm run test:shipping && npm run test:resources && npm run test:database && npm run test:deploy && npm run test:seo && npm run test:seo-routes && npm run test:customer-security && npm run test:buy-now && npm run test:categories && npm run test:pagination && npm run test:cart-catalog && npm run test:product-pricing && npm run test:request-guard && npm run test:store-domains && npm run test:store-traffic && npm run test:billing && npm run test:password-reset && npm run test:admin-alerts",
    "audit:production": "npm audit --omit=dev --audit-level=high",
    "icons:generate": "node scripts/generate-icon-css.mjs",
    "icons:check": "node scripts/generate-icon-css.mjs --check",
    "db:migrate": "node scripts/db-migrate.mjs",
    "db:seed": "node scripts/db-seed.mjs",
    "uploads:migrate": "node scripts/uploads-migrate.mjs",
    "deploy:env": "node scripts/check-deploy-config.mjs",
    "deploy:check": "npm run deploy:env && npm run lint && npm test && npm run build",
    "test:categories": "node --test scripts/test-category-navigation.mjs",
    "test:pagination": "node --test scripts/test-product-pagination.mjs",
    "test:cart-catalog": "node --test scripts/test-cart-catalog.mjs",
    "test:product-pricing": "node --test scripts/test-product-pricing.mjs",
    "test:request-guard": "node --test scripts/test-request-guard.mjs",
    "test:store-domains": "node --test scripts/test-store-domains.mjs",
    "test:store-traffic": "node --test scripts/test-store-traffic.mjs",
    "test:billing": "node --test scripts/test-billing.mjs",
    "test:password-reset": "node --test scripts/test-password-reset.mjs",
    "test:admin-alerts": "node --test scripts/test-admin-alerts.mjs",
    "admin:password": "node scripts/admin-password.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1144.0",
    "@cloudimage/360-view": "^4.10.0",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-popover": "^1.1.15",
    "@radix-ui/react-select": "^2.3.7",
    "@radix-ui/react-tooltip": "^1.2.8",
    "bcryptjs": "^3.0.3",
    "bootstrap": "^5.3.8",
    "drift-zoom": "^1.5.1",
    "echarts": "^6.1.0",
    "echarts-gl": "^2.1.0",
    "gsap": "^3.15.0",
    "imagesloaded": "^5.0.0",
    "isotope-layout": "^3.0.6",
    "jose": "^6.2.10",
    "lightgallery": "^2.9.0",
    "lucide-react": "^0.468.0",
    "matter-js": "^0.20.0",
    "next": "16.4.2",
    "odometer": "^0.4.8",
    "pg": "^8.23.0",
    "rc-slider": "^11.1.9",
    "react": "19.2.3",
    "react-datepicker": "^9.1.0",
    "react-dom": "19.2.3",
    "sass": "^1.97.3",
    "sharp": "^0.35.4",
    "swiper": "^12.1.1",
    "zod": "^4.5.4",
    "zustand": "^5.0.11"
  },
  "devDependencies": {
    "@next/bundle-analyzer": "16.4.2",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/bootstrap": "^5.2.10",
    "@types/imagesloaded": "^4.1.7",
    "@types/isotope-layout": "^3.0.15",
    "@types/matter-js": "^0.20.2",
    "@types/node": "^20",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "cross-env": "^10.1.0",
    "eslint": "^9",
    "eslint-config-next": "16.4.2",
    "eslint-plugin-unused-imports": "^4.4.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^5"
  },
  "browserslist": [
    "chrome >= 111",
    "edge >= 111",
    "firefox >= 111",
    "safari >= 16.4"
  ],
  "trustedDependencies": [
    "@parcel/watcher",
    "unrs-resolver"
  ],
  "engines": {
    "node": "^22.0.0 || ^24.0.0"
  }
}
