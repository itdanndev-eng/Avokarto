# Local development defaults only. Configure production secrets in your host's
# secret manager, then run npm run deploy:env with the production environment.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/unimart
# Optional session connection for the realtime LISTEN client and migrations.
# Leave empty when DATABASE_URL is a direct/session connection (as above).
# With Supabase, set DATABASE_URL to the transaction pooler (port 6543) and
# this to the session pooler (port 5432) - queries then share connections
# instead of each holding one of the session pooler's few client slots.
DATABASE_SESSION_URL=
DATABASE_SSL=false
# Per Node process; realtime uses one additional shared LISTEN session.
DATABASE_POOL_MAX=10
DATABASE_CONNECTION_TIMEOUT_MS=5000

# Generate a unique random value with at least 32 characters; never commit it.
JWT_SECRET=
ADMIN_SESSION_DAYS=7
CUSTOMER_SESSION_DAYS=30

# Development/demo seeding only; do not seed demo orders/catalog into a live store.
# Supply explicit credentials only for the one-off provisioning command.
ADMIN_BOOTSTRAP_EMAIL=
ADMIN_BOOTSTRAP_PASSWORD=

# Set the real HTTPS origin at BUILD and RUNTIME in production (no path/query).
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Keep false for local/staging/preview. Set true only for the public live store.
SITE_INDEXABLE=false
# Optional ownership verification tokens from Google/Bing webmaster tools.
GOOGLE_SITE_VERIFICATION=
BING_SITE_VERIFICATION=

# Set an appropriate LightGallery license key before enabling it commercially.
# This is public browser configuration, not a server secret.
NEXT_PUBLIC_LIGHTGALLERY_LICENSE_KEY=

# Where admin-uploaded images are stored.
#   local - public/uploads on this server (needs a persistent, backed-up disk)
#   s3    - any S3-compatible bucket: AWS S3, Supabase Storage, Cloudflare R2
# Switching keeps every image URL the same; run npm run uploads:migrate once
# to copy existing local files into the bucket.
UPLOAD_STORAGE=local
UPLOAD_S3_BUCKET=
UPLOAD_S3_REGION=
# Leave empty for AWS S3. Supabase: https://<project-ref>.supabase.co/storage/v1/s3
# Cloudflare R2: https://<account-id>.r2.cloudflarestorage.com
UPLOAD_S3_ENDPOINT=
# true for Supabase Storage and MinIO.
UPLOAD_S3_FORCE_PATH_STYLE=false
UPLOAD_S3_ACCESS_KEY_ID=
UPLOAD_S3_SECRET_ACCESS_KEY=
UPLOAD_S3_PREFIX=uploads/

# Reseller custom domains: the host sellers point their CNAME at (e.g.
# stores.yourshop.com, itself pointing at this server). Defaults to the
# NEXT_PUBLIC_SITE_URL host. HTTPS for seller domains needs an on-demand TLS
# edge (e.g. Caddy) that asks /api/domains/tls-check?domain=<host> first.
STORE_DOMAIN_TARGET=
# Caddy (docker-compose "caddy" service, deploy/caddy/Caddyfile):
# SITE_DOMAIN is the main host without https://, ACME_EMAIL receives
# certificate notices. Set ACME_CA to Let's Encrypt staging while testing.
SITE_DOMAIN=
ACME_EMAIL=
ACME_CA=

# Optional order confirmation email. Missing values cause email to be skipped.
# Store credentials in the deployment secret manager, never in this template.
# EMAIL_FROM must belong to a sender domain verified with your email provider.
RESEND_API_KEY=
EMAIL_FROM=
EMAIL_REPLY_TO=

# Seller subscriptions through Kelviq (lib/backend/billing.ts).
# 1. In Kelviq (app.kelviq.com) create a product with three plans whose
#    identifiers are starter, pro and scale - $17.99, $27.99 and $59.99 a month, plus
#    yearly prices if you want a yearly option. The 7-day trial is applied at
#    checkout for first-time subscribers.
# 2. Settings > API keys: paste the Server API key below.
# 3. Settings > Webhooks: add https://<your-site>/api/webhooks/kelviq with the
#    subscription.*, checkout.completed, invoice.paid and
#    invoice.payment_failed events, and paste its kq_whsec_ signing secret.
# Keep these in the deployment secret manager. Nothing is enforced until
# admin > Resellers > Marketplace rules > "Require a subscription" is on.
KELVIQ_API_KEY=
KELVIQ_WEBHOOK_SECRET=
# production (default) or sandbox - sandbox keys only work with sandbox.
KELVIQ_ENVIRONMENT=production
# Optional: the Kelviq product id, so the billing page shows live prices
# and a monthly/yearly switch.
KELVIQ_PRODUCT_ID=
# Optional: only if your Kelviq plan identifiers differ from starter/pro/scale.
KELVIQ_PLAN_STARTER=
KELVIQ_PLAN_PRO=
KELVIQ_PLAN_SCALE=
